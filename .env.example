# VeriDoc demo secrets.
# Copy to `.env.local` for real deployments and rotate every value.

# Leave empty to use the embedded PGlite database at .data/pglite.
# Set to postgres://user:pass@host:5432/db to switch to a PostgreSQL server.
DATABASE_URL=

# AES-256-GCM envelope key for the RSA private keys stored in signer_certificates.
VERIDOC_KEY_SECRET=veridoc-demo-key-envelope-secret-v1

# HMAC key for the stateless session cookie.
VERIDOC_SESSION_SECRET=veridoc-demo-session-secret-v1-change-me
